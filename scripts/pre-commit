#!/bin/sh

REPO_DIR="$(git rev-parse --show-toplevel)"
cd "$REPO_DIR" || exit 1

echo "[pre-commit] Running auto-translation..."
python3.11 tex_watch.py --translate

if [ $? -ne 0 ]; then
    echo "[pre-commit] ERROR: translation failed. Commit aborted."
    exit 1
fi

echo "[pre-commit] Regenerating index.html..."
python3.11 tex_watch.py --once

if [ $? -ne 0 ]; then
    echo "[pre-commit] ERROR: generation failed. Commit aborted."
    exit 1
fi

# Stage generated/translated files into THIS commit.
git add tex_watch.py index.html .translation_cache.json

echo "[pre-commit] Generated files staged."
exit 0